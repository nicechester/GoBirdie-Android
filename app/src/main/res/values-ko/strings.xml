    <!-- Round insights -->
    <string name="insight_sg_putting_critical">퍼팅이 이번 라운드에서 가장 큰 약점이었습니다 — 그린에서 %s타를 잃었습니다. 긴 퍼트의 거리 조절을 개선하는 것이 가장 빠른 해결책입니다.</string>
    <string name="insight_sg_approach_critical">아이언 어프로치가 가장 큰 약점이었습니다 — 그린으로 가는 샷에서 %s타를 잃었습니다. 거리 조절과 아이언 정확도를 보완해야 합니다.</string>
    <string name="insight_sg_off_tee_critical">티샷에 큰 문제가 있었습니다 — 티잉 그라운드에서 %s타를 잃었습니다. 좁은 홀에서는 비거리보다 정확도를 우선해 보세요.</string>
    <string name="insight_sg_short_game_critical">쇼트게임에서 %s타를 잃었습니다. 업앤다운 성공률을 높이는 것이 타수를 줄이는 가장 빠른 방법입니다.</string>
    <string name="insight_sg_putting_strong">퍼팅이 아주 좋았습니다 — 그린에서 %s타를 줄였습니다. 거리 조절과 그린 읽기가 훌륭했습니다.</string>
    <string name="insight_sg_approach_strong">볼 스트라이킹이 훌륭했습니다 — 어프로치 샷에서 %s타를 줄였습니다. 이런 아이언 샷은 버디 기회를 만듭니다.</string>
    <string name="insight_sg_total_positive">기준 대비 전체적으로 %s타를 줄였습니다 — 정말 강력한 전반적인 플레이입니다.</string>
    <string name="insight_fir_low_gir">페어웨이 적중률 %1$s%%, 그린 적중률은 %2$s%%에 그쳤습니다 — 드라이버로 좋은 위치를 만들었지만 아이언이 따라주지 않았습니다.</string>
    <string name="insight_low_fir_high_gir">페어웨이 적중률은 %1$s%%지만 GIR은 %2$s%% — 인상적인 아이언 회복 능력입니다. 티샷을 다듬으면 더 위협적인 선수가 될 것입니다.</string>
    <string name="insight_three_putts_critical">쓰리퍼트가 %s번 — 한 번마다 타수가 낭비됩니다. 첫 퍼트를 3피트 이내로 붙이면 피해를 막을 수 있습니다.</string>
    <string name="insight_three_putts_warning">오늘 쓰리퍼트가 %s번 있었습니다. 먼 거리 퍼트의 거리 조절을 보완해야 합니다.</string>
    <string name="insight_good_scrambling">GIR은 %1$s%%였지만 스크램블 %2$s%% 성공 — 쇼트게임이 여러 타를 지켜주어 스코어를 괜찮게 유지했습니다.</string>
    <string name="insight_poor_scrambling">그린을 %1$s%% 놓쳤고 스크램블은 %2$s%%에 그쳤습니다 — 쇼트게임 때문에 라운드당 4~5타를 잃고 있습니다.</string>
    <string name="insight_front_back_worse">전반 %1$s타, 후반 %2$s타 — 후반에 %3$s타가 늘었습니다. 체력이나 집중력이 후반에 떨어졌을 수 있습니다.</string>
    <string name="insight_front_back_better">마무리가 좋았습니다 — 전반(%2$s타)에서 후반(%3$s타)으로 %1$s타를 줄였습니다.</string>
    <string name="insight_par3_struggles">파3 홀 평균 +%s — 짧은 홀에서 티샷 아이언 정확도를 보완해야 합니다.</string>
    <string name="insight_par5_scoring">파5 홀 평균 +%s — 득점 기회를 살리지 못했습니다. 더 나은 코스 매니지먼트로 버디를 노려보세요.</string>
    <string name="insight_par5_birdie_machine">파5 홀이 주요 득점 홀이었습니다 — 오늘 평균 %s. 그곳에서의 장타와 코스 매니지먼트가 큰 강점입니다.</string>
    <string name="insight_consecutive_bogeys">보기가 연속 %s개 — 나쁜 흐름은 한 번의 실수에서 커지는 경우가 많습니다. 홀 사이에 마음을 가다듬는 루틴이 중요합니다.</string>
    <string name="insight_hr_late_round">전반에서 후반으로 심박수가 %s bpm 올랐습니다 — 후반 홀에서 피로나 긴장이 영향을 줬을 수 있습니다.</string>
    <string name="insight_worst_club">%1$s이(가) 가장 약한 클럽이었습니다 — %3$s샷 평균 SG %2$s. 이 클럽을 집중 연습하면 효과가 있을 것입니다.</string>
    <string name="insight_best_club">%1$s 감이 좋았습니다 — %3$s샷 평균 SG %2$s. 압박 속에서도 믿을 수 있는 클럽입니다.</string>
