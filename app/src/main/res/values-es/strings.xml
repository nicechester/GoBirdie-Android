    <!-- Round insights -->
    <string name="insight_sg_putting_critical">El putt fue el mayor problema de tu tarjeta: perdiste %s golpes en los greens. Controlar la velocidad en putts largos es la solución más rápida.</string>
    <string name="insight_sg_approach_critical">El juego de approach fue tu talón de Aquiles: %s golpes perdidos hasta el green. Hay que mejorar el control de distancia y la precisión con hierros.</string>
    <string name="insight_sg_off_tee_critical">Los tiros de salida fueron un problema importante: %s golpes perdidos desde el tee. Considera sacrificar distancia por precisión en hoyos estrechos.</string>
    <string name="insight_sg_short_game_critical">Tu juego corto te costó %s golpes. Hacer up-and-down de forma más constante es la forma más rápida de bajar tu score.</string>
    <string name="insight_sg_putting_strong">El putter estuvo espectacular: %s golpes ganados en los greens. Tu control de ritmo y lectura de greens fueron excelentes.</string>
    <string name="insight_sg_approach_strong">El golpeo de bola fue excelente: %s golpes ganados en approach. Ese nivel con hierros genera oportunidades de birdie.</string>
    <string name="insight_sg_total_positive">En general ganaste %s golpes frente a tu referencia: un rendimiento global realmente sólido.</string>
    <string name="insight_fir_low_gir">Acertaste el %1$s%% de calles, pero solo el %2$s%% de greens: tu salida prepara buenas posiciones, pero los hierros no las convierten.</string>
    <string name="insight_low_fir_high_gir">Solo el %1$s%% de calles, pero %2$s%% GIR: una recuperación impresionante con hierros. Mejorar los tiros de salida te haría aún más peligroso.</string>
    <string name="insight_three_putts_critical">%s tres-putts: cada uno es un golpe desperdiciado. Dejar el primer putt a menos de 3 pies elimina el daño.</string>
    <string name="insight_three_putts_warning">Hoy %s tres-putts. Hay que trabajar el control de distancia en putts largos.</string>
    <string name="insight_good_scrambling">Solo %1$s%% GIR, pero recuperaste el %2$s%% — tu juego corto te ahorró varios golpes y mantuvo un score respetable.</string>
    <string name="insight_poor_scrambling">Fallaste el %1$s%% de greens y solo recuperaste el %2$s%% — el juego corto te cuesta de 4 a 5 golpes por ronda.</string>
    <string name="insight_front_back_worse">Ida %1$s, vuelta %2$s: una caída de %3$s golpes. Puede que el cansancio o la concentración hayan bajado al final.</string>
    <string name="insight_front_back_better">Gran final: mejoraste %1$s golpes de la ida (%2$s) a la vuelta (%3$s).</string>
    <string name="insight_par3_struggles">Los par 3 promediaron +%s sobre par: la precisión de hierro desde el tee necesita atención en los hoyos cortos.</string>
    <string name="insight_par5_scoring">Los par 5 promediaron +%s: no aprovechas los hoyos para anotar. Una mejor gestión del campo podría darte birdies.</string>
    <string name="insight_par5_birdie_machine">Los par 5 son tus hoyos para anotar: promedio %s hoy. Tu potencia y gestión del campo allí son una verdadera fortaleza.</string>
    <string name="insight_consecutive_bogeys">%s bogeys seguidos: las malas rachas suelen crecer a partir de un mal golpe. Una rutina de reinicio entre hoyos es clave.</string>
    <string name="insight_hr_late_round">La FC subió %s lpm de la ida a la vuelta: el cansancio o la presión pudieron influir en los últimos hoyos.</string>
    <string name="insight_worst_club">Tu %1$s fue tu palo más débil: SG medio %2$s en %3$s golpes. Practicar específicamente con este palo daría buenos resultados.</string>
    <string name="insight_best_club">Tu %1$s estuvo en su punto: SG medio %2$s en %3$s golpes. Es un palo en el que puedes confiar bajo presión.</string>
    <string name="insight_driver_inconsistent">La distancia con el driver fue muy irregular (±%s yardas): céntrate en el contacto central en lugar de la distancia máxima para ser más constante.</string>
    <string name="insight_one_putts_high">Hoy %s one-putts: embocaste de cerca de forma constante. Es un verdadero activo para tu score.</string>
    <string name="insight_zero_three_putts">Cero tres-putts: el control de distancia en putts largos fue excelente. Gran lectura de greens y buen criterio de ritmo.</string>
    <string name="insight_longest_drive">Drive más largo: %s yardas, gran potencia desde el tee.</string>
    <string name="insight_driver_down_vs_history">La distancia media con el driver fue unas %s yardas menor que tu promedio reciente. Revisa si el cansancio o cambios en tu swing afectan la potencia.</string>
    <string name="insight_driver_up_vs_history">La distancia media con el driver fue unas %s yardas mayor que tu promedio reciente: hoy tu swing estuvo muy bien.</string>
    <string name="insight_approach_worse_vs_history">Los approaches quedaron en promedio unas %s yardas más lejos del banderín que tu promedio reciente: los hierros no estuvieron tan finos hoy.</string>
    <string name="insight_approach_better_vs_history">Los approaches quedaron en promedio unas %s yardas más cerca del banderín que tu promedio reciente: hoy los hierros estuvieron afinados.</string>
    <string name="insight_round_duration_long">La ronda duró %s minutos: el cansancio mental de más de 4 horas puede afectar tus decisiones en la vuelta.</string>

